<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE configuration
        PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-config.dtd">
<configuration>
    <settings>
        <setting name="logImpl" value="LOG4J2"/>
        <setting name="defaultEnumTypeHandler" value="org.apache.ibatis.type.EnumTypeHandler"/>
        <!-- see mybatis-config.xml: avoid stale reads from MyBatis' session-level local cache -->
        <setting name="localCacheScope" value="STATEMENT"/>
        <!-- see mybatis-config.xml: column naming is handled by convention, not resultMaps -->
        <setting name="mapUnderscoreToCamelCase" value="true"/>
        <!-- see mybatis-config.xml -->
        <setting name="autoMappingUnknownColumnBehavior" value="${autoMappingUnknownColumnBehavior}"/>
    </settings>
    <typeHandlers>
    </typeHandlers>
    <environments default="development">
        <environment id="development">
            <transactionManager type="JDBC">
                <property name="isolationLevel" value="READ_COMMITTED" />
            </transactionManager>
            <dataSource type="POOLED">
                <property name="driver" value="${driver}"/>
                <property name="url" value="${url}"/>
                <property name="username" value="${username}"/>
                <property name="password" value="${password}"/>
                <property name="poolMaximumActiveConnections" value="${poolMaximumActiveConnections}"/>
            </dataSource>
        </environment>
    </environments>
    <mappers>
        <mapper resource="com/dewarim/cinnamon/AccessLogMapper.xml"/>
    </mappers>
</configuration>