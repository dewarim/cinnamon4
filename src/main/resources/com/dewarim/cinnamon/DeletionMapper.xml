<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dewarim.cinnamon.model.Deletion">

    <select id="list" parameterType="map" resultType="com.dewarim.cinnamon.model.Deletion">
        SELECT *
        FROM deletions
    </select>

    <delete id="delete" parameterType="list">
        DELETE
        FROM deletions
        WHERE osd_id in
        <foreach item="item" index="index" collection="list"
                 open="(" separator="," close=")">
            #{item}
        </foreach>
    </delete>

    <!--
      osd_id is this table's key - it is the unique not-null column, and there is no id column at
      all - so it identifies the row rather than being one of the values that are set.
    -->
    <update id="update" parameterType="com.dewarim.cinnamon.model.Deletion">
        UPDATE deletions
        SET content_path = #{contentPath},
            deleted      = #{deleted},
            delete_failed= #{deleteFailed}
        WHERE osd_id = #{osdId}
    </update>

    <insert id="insert" parameterType="com.dewarim.cinnamon.model.Deletion">
        INSERT INTO deletions(osd_id, content_path, deleted, delete_failed)
        VALUES (#{osdId}, #{contentPath}, #{deleted}, #{deleteFailed})
    </insert>

    <select id="getAllById" parameterType="list" resultType="com.dewarim.cinnamon.model.Deletion">
        SELECT *
        FROM deletions
        WHERE osd_id in
        <foreach item="item" index="index" collection="list"
                 open="(" separator="," close=")">
            #{item}
        </foreach>
    </select>

    <select id="getDeletionById" parameterType="long" resultType="com.dewarim.cinnamon.model.Deletion">
        SELECT *
        FROM deletions
        WHERE osd_id = #{id}
    </select>

    <select id="listPendingDeletions" resultType="com.dewarim.cinnamon.model.Deletion">
        SELECT *
        FROM deletions
        WHERE deleted = false AND delete_failed=false
    </select>

</mapper>