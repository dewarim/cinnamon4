<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dewarim.cinnamon.model.FolderType">

    <select id="list" parameterType="map" resultType="com.dewarim.cinnamon.model.FolderType">
        SELECT id, name
        FROM folder_types
    </select>

    <select id="getFolderTypeById" parameterType="Long" resultType="com.dewarim.cinnamon.model.FolderType">
        SELECT id, name
        FROM folder_types
        WHERE id = #{id}
    </select>

    <select id="getFolderTypeByName" parameterType="String" resultType="com.dewarim.cinnamon.model.FolderType">
        SELECT id, name
        FROM folder_types
        WHERE name = #{name}
    </select>

    <update id="update" parameterType="com.dewarim.cinnamon.model.FolderType">
        UPDATE folder_types
        SET name = #{name}
        WHERE id = #{id}
    </update>

    <insert id="insert" parameterType="com.dewarim.cinnamon.model.FolderType">
        <selectKey keyProperty="id" resultType="long" order="BEFORE">
            select nextval('seq_folder_type_id')
        </selectKey>
        INSERT INTO folder_types (id,name) VALUES (#{id}, #{name})
    </insert>

    <delete id="delete" parameterType="list">
        DELETE
        FROM folder_types
        WHERE id in
        <foreach item="item" index="index" collection="list"
                 open="(" separator="," close=")">
            #{item}
        </foreach>
    </delete>

    <select id="getAllById" parameterType="list" resultType="com.dewarim.cinnamon.model.FolderType">
        SELECT id, name
        FROM folder_types
        WHERE id in
        <foreach item="item" index="index" collection="list"
                 open="(" separator="," close=")">
            #{item}
        </foreach>
    </select>
</mapper>