<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dewarim.cinnamon.model.event.AccessLogEntry">

    <select id="list" resultType="com.dewarim.cinnamon.model.event.AccessLogEntry">
        select * from access_log
    </select>

    <insert id="insert" parameterType="com.dewarim.cinnamon.model.event.AccessLogEntry">
        <selectKey keyProperty="id" resultType="long" order="BEFORE">
            select nextval('seq_access_log')
        </selectKey>
        INSERT INTO access_log(id, request, response, error_code, error_message, url, user_id)
        values(#{id}, #{request}, #{response}, #{errorCode}, #{errorMessage}, #{url}, #{userId})
    </insert>

    <!--
      What admin/listAccessLog reads. Limited because every row holds a whole request body and a
      whole error response, and ordered by id rather than by created: created comes from the column
      default, so rows written in the same millisecond would have no defined order, while the id
      comes from a sequence.
    -->
    <select id="listNewest" parameterType="map" resultType="com.dewarim.cinnamon.model.event.AccessLogEntry">
        select *
        from access_log
        order by id desc
        limit #{limit}
    </select>

    <select id="count" resultType="int">
        select count(*) from access_log
    </select>

    <delete id="truncate" parameterType="int">
        delete
        from access_log
        where id in (select id
                     from access_log
                     order by id
                     limit #{numberOfRowsToDelete})
    </delete>
</mapper>