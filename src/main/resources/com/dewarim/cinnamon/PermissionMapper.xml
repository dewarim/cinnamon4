<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dewarim.cinnamon.model.Permission">

    <select id="list" resultType="com.dewarim.cinnamon.model.Permission">
        SELECT *
        FROM permissions
    </select>

    <select id="getAclGroupPermissionsForAclGroup" parameterType="long" resultType="com.dewarim.cinnamon.model.Permission">
        SELECT p.*
        FROM permissions p JOIN acl_group_permissions agp on p.id = agp.permission_id
        WHERE agp.acl_group_id=#{aclGroupId}
    </select>

    <select id="getPermissionByName" resultType="com.dewarim.cinnamon.model.Permission">
        SELECT *
        FROM permissions
        WHERE name = #{name}
    </select>

    <select id="getUserPermissionsForAclGroups" resultType="com.dewarim.cinnamon.model.Permission">
        SELECT p.*
        FROM permissions p
        JOIN acl_group_permissions a on p.id = a.permission_id
        WHERE a.acl_group_id in
        <foreach item="item" index="index" collection="list"
                 open="(" separator="," close=")">
            #{item.id}
        </foreach>
    </select>

</mapper>