<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dewarim.cinnamon.model.AclGroupPermission">

    <select id="getAclGroupPermissionForAclGroupsAndPermission" parameterType="map" resultType="com.dewarim.cinnamon.model.AclGroupPermission">
        SELECT *
        FROM acl_group_permissions
        WHERE acl_group_id IN
        <foreach item="item" index="index" collection="aclGroups"
                 open="(" separator="," close=")">
            #{item.id}
        </foreach>
        AND permission_id = #{permissionId}
    </select>

    <!--
      All acl ids that grant the given permission to a user, either through one of the user's own
      groups or through the "everyone" group. This replaces a per-acl loop of three queries in
      AccessFilter.generateObjectAclSet, whose cost grew with the number of acls in the system.
    -->
    <select id="listAclIdsWithPermissionForGroups" parameterType="map" resultType="long">
        SELECT DISTINCT ag.acl_id
        FROM acl_groups ag
        JOIN acl_group_permissions agp ON agp.acl_group_id = ag.id
        JOIN groups g ON g.id = ag.group_id
        WHERE agp.permission_id = #{permissionId}
        AND (g.name = #{everyoneGroupName}
        <if test="groupIds != null and groupIds.size() > 0">
            OR ag.group_id IN
            <foreach item="item" collection="groupIds" open="(" separator="," close=")">#{item}</foreach>
        </if>
        )
    </select>

    <select id="listByAclGroupIds" parameterType="list" resultType="com.dewarim.cinnamon.model.AclGroupPermission">
        SELECT *
        FROM acl_group_permissions
        WHERE acl_group_id IN
        <foreach item="item" index="index" collection="list"
                 open="(" separator="," close=")">
            #{item}
        </foreach>
    </select>

    <insert id="insert" parameterType="com.dewarim.cinnamon.model.AclGroupPermission">
        <selectKey keyProperty="id" resultType="long" order="BEFORE">
            select nextval('seq_acl_group_permission_id')
        </selectKey>
        INSERT INTO acl_group_permissions (id, acl_group_id, permission_id) VALUES (#{id}, #{aclGroupId},
        #{permissionId})
    </insert>

    <delete id="delete">
        DELETE
        FROM acl_group_permissions
        WHERE id = #{id}
    </delete>

</mapper>