<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dewarim.cinnamon.model.index.IndexJob">


    <resultMap id="indexJobMap" type="com.dewarim.cinnamon.model.index.IndexJob">
        <id property="id" column="id"/>
        <result property="itemId" column="item_id"/>
        <result property="jobType" column="job_type"/>
        <result property="action" column="action"/>
        <result property="failed" column="failed"/>
    </resultMap>

    <!-- order by item_id to get the newest index_job first -->
    <select id="getIndexJobsByFailedCount" resultMap="indexJobMap">
        SELECT *
        FROM index_jobs
        WHERE failed &lt;= #{failed}
        ORDER BY item_id DESC
    </select>

    <select id="countJobs" resultType="int">
        SELECT count(*)
        FROM index_jobs
    </select>

    <select id="countFailedJobs" resultType="int">
        SELECT count(*)
        FROM index_jobs
        WHERE failed > 0
    </select>

    <!--
      One row per (job_type, item_id): a second "update this index-item" entry would be redundant,
      since IndexService always indexes the item's current state rather than a diff.

      The pending row must not be reused silently, though. IndexService reads a job, loads a
      snapshot of the item, indexes that snapshot, and only then deletes the job by id. A change
      committed inside that window would be lost for good if its insert were simply dropped here:
      the index would keep the document built from the stale snapshot, the job would be gone, and
      nothing would be left to retry it - no failed job, no error.

      So a conflicting insert takes the row over with a fresh id. The in-flight indexer's
      "DELETE ... WHERE id = {old id}" then matches nothing, the row survives, and the next pass
      indexes the item from a current snapshot. The price is an occasional redundant re-index,
      which is idempotent - the alternative is losing the change.

      failed is deliberately left as it is, so that a job cannot escape maxIndexAttempts by being
      touched over and over.
    -->
    <insert id="insert" parameterType="com.dewarim.cinnamon.model.index.IndexJob">
        <selectKey keyProperty="id" resultType="long" order="BEFORE">
            select nextval('seq_index_job_id')
        </selectKey>
        INSERT INTO index_jobs(id, item_id, job_type, action, failed)
        VALUES (#{id}, #{itemId}, #{jobType}, #{action}, 0)
        ON CONFLICT (job_type, item_id) DO UPDATE SET id = #{id}
    </insert>

    <delete id="delete" parameterType="long">
        DELETE
        FROM index_jobs
        WHERE id = #{id}
    </delete>

    <update id="updateStatus" parameterType="com.dewarim.cinnamon.model.index.IndexJob">
        UPDATE index_jobs
        SET failed=#{failed}
        WHERE id = #{id}
    </update>

    <select id="getIndexJobById" resultMap="indexJobMap">
        SELECT *
        FROM index_jobs
        WHERE id = #{id}
    </select>

    <select id="list" resultMap="indexJobMap">
        SELECT *
        FROM index_jobs
    </select>

    <select id="listFailedIndexJobs" resultMap="indexJobMap">
        SELECT *
        FROM index_jobs
        WHERE failed > 0
    </select>

    <insert id="reindexAllOsds" parameterType="boolean">
        INSERT INTO index_jobs(id, item_id, job_type, action, failed)
        SELECT nextval('seq_index_job_id'), id, 'OSD', 'UPDATE', 0
        FROM objects
        ON CONFLICT DO NOTHING
    </insert>

    <insert id="reindexAllFolders">
        INSERT INTO index_jobs(id, item_id, job_type, action, failed)
        SELECT nextval('seq_index_job_id'), id, 'FOLDER', 'UPDATE', 0
        FROM folders
        ON CONFLICT DO NOTHING
    </insert>

    <insert id="reindexOsds" parameterType="map">
        INSERT INTO index_jobs(id, item_id, job_type, action, failed)
        SELECT nextval('seq_index_job_id'), id,
        'OSD', 'UPDATE', 0 FROM objects
        WHERE objects.id in
        <foreach item="item" index="index" collection="ids"
                 open="(" separator="," close=")">
            #{item}
        </foreach>
        ON CONFLICT DO NOTHING
    </insert>

    <insert id="reindexFolders" parameterType="list">
        INSERT INTO index_jobs(id,item_id,job_type,action,failed)
        SELECT nextval('seq_index_job_id'), id,
        'FOLDER', 'UPDATE', 0 FROM folders
        WHERE folders.id in
        <foreach item="item" index="index" collection="list"
                 open="(" separator="," close=")">
            #{item}
        </foreach>
        ON CONFLICT DO NOTHING
    </insert>

</mapper>