<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  Columns are listed explicitly rather than SELECT *: the sessions table also holds
  username and ui_language_id, which the Session model does not carry. With
  mapUnderscoreToCamelCase doing the mapping, a SELECT * would hand MyBatis two columns
  it cannot place - silently under NONE, and as an error under the FAILING behaviour the
  test run uses.
-->
<mapper namespace="com.dewarim.cinnamon.SessionMapper">

    <select id="getSessionByTicket" parameterType="String" resultType="com.dewarim.cinnamon.model.Session">
        SELECT id, ticket, expires, user_id
        FROM sessions
        WHERE ticket = #{ticket}
    </select>

    <select id="listSessions" resultType="com.dewarim.cinnamon.model.Session">
        SELECT id, ticket, expires, user_id
        FROM sessions
    </select>

    <insert id="insertSession" parameterType="com.dewarim.cinnamon.model.Session" flushCache="true">
        <selectKey keyProperty="id" resultType="long" order="BEFORE">
            select nextval('seq_session_id')
        </selectKey>

        INSERT INTO sessions (id, ticket, expires, user_id)
        VALUES (#{id},#{ticket}, #{expires}, #{userId})
    </insert>

    <!-- Only field that should be updated is the expiration time when a session is renewed before it expires -->
    <update id="updateSession" parameterType="com.dewarim.cinnamon.model.Session" flushCache="true">
        UPDATE sessions
        SET expires = #{expires}
        WHERE id = #{id}
    </update>

    <delete id="deleteSession" parameterType="long" flushCache="true">
        DELETE
        FROM sessions
        WHERE id = #{id}
    </delete>

</mapper>