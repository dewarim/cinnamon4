<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dewarim.cinnamon.model.ObjectType">

    <select id="list" parameterType="map" resultType="com.dewarim.cinnamon.model.ObjectType">
        SELECT id, name
        FROM object_types
    </select>

    <update id="update" parameterType="com.dewarim.cinnamon.model.ObjectType">
        UPDATE object_types
        SET name = #{name}
        WHERE id = #{id}
    </update>

    <insert id="insert" parameterType="com.dewarim.cinnamon.model.ObjectType">
        <selectKey keyProperty="id" resultType="long" order="BEFORE">
            select nextval('seq_obj_type_id')
        </selectKey>
        INSERT INTO object_types (id,name) VALUES (#{id}, #{name})
    </insert>

    <delete id="delete" parameterType="list">
        DELETE
        FROM object_types
        WHERE id in
        <foreach item="item" index="index" collection="list"
                 open="(" separator="," close=")">
            #{item}
        </foreach>
    </delete>

    <select id="getAllById" parameterType="list" resultType="com.dewarim.cinnamon.model.ObjectType">
        SELECT id, name
        FROM object_types
        WHERE id in
        <foreach item="item" index="index" collection="list"
                 open="(" separator="," close=")">
            #{item}
        </foreach>
    </select>

</mapper>