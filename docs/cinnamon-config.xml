<CinnamonConfig>
  <serverConfig>
    <systemRoot>/opt/cinnamon/data/config</systemRoot>
    <dataRoot>/opt/cinnamon/data/content</dataRoot>
    <enableHttps>false</enableHttps>
    <maxThreads>200</maxThreads>
    <httpConnectorConfig>
      <port>8080</port>
      <acceptors>1</acceptors>
      <selectors>1</selectors>
      <acceptQueueSize>128</acceptQueueSize>
    </httpConnectorConfig>
    <httpsConnectorConfig>
      <port>8443</port>
      <acceptors>1</acceptors>
      <selectors>1</selectors>
      <acceptQueueSize>128</acceptQueueSize>
      <keyStorePath>my.keystore</keyStorePath>
      <keyStorePassword>secret</keyStorePassword>
    </httpsConnectorConfig>
    <verifyExistence>true</verifyExistence>
    <ignoreNopUpdates>false</ignoreNopUpdates>
    <log4jConfigPath>/opt/cinnamon/log4j.xml</log4jConfigPath>
  </serverConfig>
  <systemAdministratorEmail/>
  <mailConfig>
    <smtpHost/>
    <smtpUser/>
    <smtpPassword/>
  </mailConfig>
  <securityConfig>
    <passwordRounds>10</passwordRounds>
    <minimumPasswordLength>8</minimumPasswordLength>
    <transferAssetsAllowed>true</transferAssetsAllowed>
    <deleteUserAllowed>true</deleteUserAllowed>
    <sessionLengthInMillis>864000000</sessionLengthInMillis>
    <ldapConfig>
      <ldapConnectorEnabled>false</ldapConnectorEnabled>
      <host>localhost</host>
      <port>10389</port>
      <bindDnFormatString>cn=%s,cn=Users,dc=localhost</bindDnFormatString>
      <searchBaseDnFormatString>cn=retrieval-users,cn=Users,dc=localhost</searchBaseDnFormatString>
      <searchFilter>(&amp;(objectclass=*))</searchFilter>
      <searchAttributeForGroup>member</searchAttributeForGroup>
      <searchAttributeForDn>distinguishedName</searchAttributeForDn>
      <defaultLanguageCode>und</defaultLanguageCode>
      <staticBindPassword/>
      <groupMappings/>
    </ldapConfig>
  </securityConfig>
  <databaseConfig>
    <driver>org.postgresql.Driver</driver>
    <host>127.0.0.1</host>
    <port>5432</port>
    <database>cinnamon</database>
    <user>cinnamon</user>
    <password>CINNAMON_DB_USER_PWD</password>
  </databaseConfig>
  <luceneConfig>
   <indexPath>/opt/cinnamon/data/index</indexPath>
   <millisToWaitBetweenRuns>1000</millisToWaitBetweenRuns>
   <maxIndexAttempts>1</maxIndexAttempts>
   <maxBatchSize>64</maxBatchSize>
   <verifySearchResults>true</verifySearchResults>
   <!-- also index every single CJK character, not just the bigrams that make CJK text searchable.
        Off by default: words of two or more characters are findable without it, while turning it on
        roughly doubles the number of CJK terms. Needs a reindex to take effect. -->
   <cjkOutputUnigrams>false</cjkOutputUnigrams>
 </luceneConfig>
  <cinnamonTikaConfig>
    <baseUrl>http://127.0.0.1:9998</baseUrl>
    <useTika>true</useTika>
  </cinnamonTikaConfig>
  <loginProviders/>
  <changeTriggerConfig>
    <socketTimeoutSeconds>60</socketTimeoutSeconds>
    <connectionTimeoutSeconds>60</connectionTimeoutSeconds>
    <timeToLiveSeconds>600</timeToLiveSeconds>
    <tlsVersions>
      <tlsVersion>V_1_3</tlsVersion>
    </tlsVersions>
  </changeTriggerConfig>
  <!-- limits of the JDK XML parser for user supplied XML (content, metadata); defaults as in JDK 25, 0 = no limit -->
  <xmlParserConfig>
    <entityExpansionLimit>2500</entityExpansionLimit>
    <totalEntitySizeLimit>100000</totalEntitySizeLimit>
    <maxGeneralEntitySizeLimit>100000</maxGeneralEntitySizeLimit>
    <maxParameterEntitySizeLimit>15000</maxParameterEntitySizeLimit>
    <entityReplacementLimit>100000</entityReplacementLimit>
    <elementAttributeLimit>200</elementAttributeLimit>
    <maxElementDepth>100</maxElementDepth>
    <maxXMLNameLimit>1000</maxXMLNameLimit>
  </xmlParserConfig>
  <!-- HTTP/HTTPS layer limits and information disclosure; sizes in bytes, 0 = unlimited -->
  <httpLimitsConfig>
    <maxRequestBodySize>67108864</maxRequestBodySize>
    <maxMultipartRequestSize>0</maxMultipartRequestSize>
    <maxMultipartFileSize>0</maxMultipartFileSize>
    <multipartFileSizeThreshold>1048576</multipartFileSizeThreshold>
    <sendServerVersion>false</sendServerVersion>
    <showStackTraces>false</showStackTraces>
    <requestHeaderSize>8192</requestHeaderSize>
  </httpLimitsConfig>
</CinnamonConfig>